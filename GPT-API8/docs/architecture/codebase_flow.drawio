        <mxCell id="ts-i2" value="Active ontology in memory&#xa;loaded at startup or by upload&#xa;(triple schema and constraints)" style="shape=database;whiteSpace=wrap;html=1;fillColor=#f7f4ef;strokeColor=#827b72;" vertex="1" parent="1t">
          <mxGeometry x="90" y="290" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ts-i3" value="Session state&#xa;base_kb_json (seed) and&#xa;current_kb_json (working graph)&#xa;(empty in create_new mode)" style="shape=database;whiteSpace=wrap;html=1;fillColor=#f7f4ef;strokeColor=#827b72;fontStyle=1;" vertex="1" parent="1t">
          <mxGeometry x="90" y="470" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ts-inote" value="Setup note&#xa;If no base graph / `query.json` exists, the session starts empty and the KG is created from scratch." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;" vertex="1" parent="1t">
          <mxGeometry x="80" y="680" width="280" height="120" as="geometry" />
