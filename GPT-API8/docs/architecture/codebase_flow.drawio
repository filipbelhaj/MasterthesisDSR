        <mxCell id="ts-r3" value="SQLite FTS retrieval&#xa;over the current working graph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcecf7;strokeColor=#7a9fb0;" vertex="1" parent="1t">
