        <mxCell id="arch-finalize" value="Finalize page&#xa;Review final graph&#xa;and export output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0cf;strokeColor=#cfb26a;fontStyle=1;" vertex="1" parent="1s">
          <mxGeometry x="120" y="500" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="arch-graph" value="Graph renderer&#xa;Draws old and new rows&#xa;and highlights changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde0d7;strokeColor=#c1775f;" vertex="1" parent="1s">
          <mxGeometry x="120" y="720" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="arch-browser" value="Browser local state&#xa;localStorage keeps the&#xa;session id and last proposal id" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;" vertex="1" parent="1s">
          <mxGeometry x="120" y="900" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="arch-app" value="FastAPI application&#xa;Serves the site and&#xa;loads ontology at startup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6dfef;strokeColor=#9a86a8;fontStyle=1;" vertex="1" parent="1s">
          <mxGeometry x="600" y="110" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="arch-api" value="API layer&#xa;Uploads, proposals, approval,&#xa;state lookup, and export" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeee2;strokeColor=#7ca483;fontStyle=1;" vertex="1" parent="1s">
          <mxGeometry x="600" y="290" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="arch-models" value="Request schemas&#xa;Validate API payloads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeee2;strokeColor=#7ca483;" vertex="1" parent="1s">
          <mxGeometry x="600" y="470" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="arch-state" value="Session state&#xa;SESSIONS / PROPOSALS, base/current graph,&#xa;history, kb_revision, deltas, dedupe&#xa;(empty in create_new mode)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeee2;strokeColor=#7ca483;fontStyle=1;" vertex="1" parent="1s">
          <mxGeometry x="600" y="620" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="arch-config" value="Runtime settings&#xa;Models, paths, host, and limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeee2;strokeColor=#7ca483;" vertex="1" parent="1s">
          <mxGeometry x="600" y="820" width="320" height="90" as="geometry" />
        </mxCell>

        <mxCell id="arch-extractor" value="Extraction engine&#xa;Retrieves graph context, builds prompts,&#xa;calls GPT, and prepares results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcecf7;strokeColor=#7a9fb0;fontStyle=1;" vertex="1" parent="1s">
          <mxGeometry x="1160" y="110" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="arch-prompt" value="System prompt&#xa;GPT extraction instructions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee6cf;strokeColor=#d18c57;" vertex="1" parent="1s">
          <mxGeometry x="1160" y="330" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="arch-kbindex" value="Retrieval index&#xa;Builds FTS candidates for&#xa;embedding reranking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcecf7;strokeColor=#7a9fb0;" vertex="1" parent="1s">
          <mxGeometry x="1160" y="490" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="arch-converter" value="Export generator&#xa;Turns delta rows into one-step or&#xa;two-step QuickStatements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcecf7;strokeColor=#7a9fb0;" vertex="1" parent="1s">
          <mxGeometry x="1160" y="670" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="arch-nonai" value="Important&#xa;After GPT responds, the backend still handles validation, entity reuse, merging, and explanation building." style="shape=note;whiteSpace=wrap;html=1;fillColor=#dcecf7;strokeColor=#7a9fb0;" vertex="1" parent="1s">
          <mxGeometry x="1160" y="860" width="320" height="120" as="geometry" />
        </mxCell>

        <mxCell id="arch-ontology" value="Ontology JSON&#xa;startup source + uploads&#xa;(triple schema)" style="shape=database;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1s">
          <mxGeometry x="1740" y="120" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="arch-query" value="Optional base graph seed&#xa;DEFAULT_QUERY_FILE / query.json" style="shape=database;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1s">
          <mxGeometry x="1740" y="250" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="arch-sessions" value="Runtime memory&#xa;SESSIONS + PROPOSALS&#xa;live until restart" style="shape=database;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1s">
          <mxGeometry x="1740" y="390" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="arch-openai" value="OpenAI API&#xa;embeddings + chat completions" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1s">
