        </mxCell>
        <mxCell id="ts-rnote" value="Important&#xa;The ontology is not embedded. Embeddings are used only to rerank candidate KB rows before the GPT call." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fde0d7;strokeColor=#c1775f;" vertex="1" parent="1t">
          <mxGeometry x="500" y="1100" width="580" height="80" as="geometry" />
