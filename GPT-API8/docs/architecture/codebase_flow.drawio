        <mxCell id="p16" value="Create-new mode&#xa;If no `query.json` exists, the session starts with an empty graph and the KG is built from scratch." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;" vertex="1" parent="1p">
