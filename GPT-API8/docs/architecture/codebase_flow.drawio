        <mxCell id="l2" value="Send system prompt and&#xa;user message to GPT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeee2;strokeColor=#7ca483;fontStyle=1;" vertex="1" parent="1a">
          <mxGeometry x="1390" y="350" width="260" height="150" as="geometry" />
