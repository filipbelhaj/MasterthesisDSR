        <mxCell id="ts-r4" value="Candidate KB rows&#xa;bounded subset returned by retrieval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f4ef;strokeColor=#827b72;fontStyle=1;" vertex="1" parent="1t">
          <mxGeometry x="640" y="460" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ts-r5" value="Embedding-based reranking&#xa;embed input text + candidate rows&#xa;and compare by vector similarity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcecf7;strokeColor=#7a9fb0;fontStyle=1;" vertex="1" parent="1t">
