        </mxCell>
        <mxCell id="p5a" value="Entity hints&#xa;from labels seen in the text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0cf;strokeColor=#cfb26a;" vertex="1" parent="1a">
