  <diagram id="proposal-pipeline" name="Proposal Generation Pipeline">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0p" />
        <mxCell id="1p" parent="0p" />
        <mxCell id="p1" value="1. User submits source text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1p">
          <mxGeometry x="70" y="100" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="2. POST /api/propose" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1p">
          <mxGeometry x="340" y="100" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="3. Create or load session&#xa;with current rows and kb_revision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1p">
          <mxGeometry x="620" y="100" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="4. Build prompt payload&#xa;source text + ontology rules + preview rows&#xa;+ entity hints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1p">
          <mxGeometry x="920" y="100" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="5. Retrieve graph context&#xa;label hits + SQLite FTS +&#xa;embedding reranking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1p">
          <mxGeometry x="920" y="240" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="6. GPT returns structured JSON&#xa;with proposed rows and changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1p">
          <mxGeometry x="920" y="390" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p7" value="7. Validate rows&#xa;drop invalid / ontology-invalid rows&#xa;and dedupe exact triples" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1p">
          <mxGeometry x="920" y="530" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p8" value="8. Reuse existing entities&#xa;and normalize ids" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1p">
          <mxGeometry x="920" y="670" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p9" value="9. Build merged preview&#xa;skip rows already in the base graph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1p">
          <mxGeometry x="920" y="810" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p10" value="10. Build reasoning report&#xa;for the reviewer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1p">
          <mxGeometry x="1260" y="810" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p11" value="11. Store proposal + metrics&#xa;and return the review package" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1p">
          <mxGeometry x="1260" y="530" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p12" value="12. Browser shows the proposal&#xa;JSON, reasoning, and graph preview" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1p">
          <mxGeometry x="1260" y="240" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p15" value="13. Build preview graph&#xa;from base_kb_json + proposed_kb_json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1p">
          <mxGeometry x="1260" y="360" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p13" value="Ontology JSON&#xa;(triple schema)" style="shape=database;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1p">
          <mxGeometry x="1260" y="100" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p14" value="Current working graph&#xa;session[&quot;current_kb_json&quot;]&#xa;(empty in create_new mode)" style="shape=database;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1p">
