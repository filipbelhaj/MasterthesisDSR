        </mxCell>
        <mxCell id="s5" value="Important&#xa;The ontology is not embedded.&#xa;It is inserted into the prompt as structured data." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde0d7;strokeColor=#c1775f;fontStyle=1;" vertex="1" parent="1a">
          <mxGeometry x="70" y="650" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="E. Source text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0cf;strokeColor=#cfb26a;fontStyle=1;" vertex="1" parent="1a">
          <mxGeometry x="70" y="810" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="r1" value="F. Send text to backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeee2;strokeColor=#7ca483;fontStyle=1;" vertex="1" parent="1a">
          <mxGeometry x="470" y="110" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="G. Load or create session&#xa;with current rows and kb_revision&#xa;(empty if no base graph exists)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeee2;strokeColor=#7ca483;" vertex="1" parent="1a">
          <mxGeometry x="470" y="230" width="310" height="110" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="H. Retrieve the most relevant&#xa;graph context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6dfef;strokeColor=#9a86a8;fontStyle=1;" vertex="1" parent="1a">
          <mxGeometry x="470" y="390" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="H1. Direct text matches&#xa;from item/value labels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcecf7;strokeColor=#7a9fb0;" vertex="1" parent="1a">
          <mxGeometry x="470" y="510" width="140" height="110" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="H2. SQLite FTS search over&#xa;the current working graph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcecf7;strokeColor=#7a9fb0;" vertex="1" parent="1a">
          <mxGeometry x="635" y="510" width="145" height="110" as="geometry" />
        </mxCell>
        <mxCell id="r5b" value="H3. Candidate KB rows&#xa;bounded subset from FTS retrieval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f4ef;strokeColor=#827b72;fontStyle=1;" vertex="1" parent="1a">
          <mxGeometry x="545" y="655" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="H4. Embed the input text and candidate rows&#xa;then rerank by vector similarity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcecf7;strokeColor=#7a9fb0;" vertex="1" parent="1a">
          <mxGeometry x="470" y="780" width="310" height="100" as="geometry" />
        </mxCell>
        <mxCell id="r6b" value="H5. Top-K preview rows&#xa;selected as GPT context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee6cf;strokeColor=#d18c57;fontStyle=1;" vertex="1" parent="1a">
          <mxGeometry x="535" y="920" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r7" value="Important&#xa;The embedding model works only in H4.&#xa;The ontology itself is not embedded." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde0d7;strokeColor=#c1775f;fontStyle=1;" vertex="1" parent="1a">
          <mxGeometry x="470" y="1030" width="310" height="90" as="geometry" />
        </mxCell>

        <mxCell id="p1a" value="I. Assemble prompt payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6dfef;strokeColor=#9a86a8;fontStyle=1;" vertex="1" parent="1a">
          <mxGeometry x="970" y="110" width="230" height="70" as="geometry" />
