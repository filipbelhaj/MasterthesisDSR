          <mxGeometry x="500" y="130" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ts-r2" value="Direct lexical label hits&#xa;from item/value labels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcecf7;strokeColor=#7a9fb0;" vertex="1" parent="1t">
