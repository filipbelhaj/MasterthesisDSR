  <diagram id="detailed-workflow" name="Session Lifecycle">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2760" pageHeight="1940" math="0" shadow="0">
      <root>
        <mxCell id="0w" />
        <mxCell id="1w" parent="0w" />

        <mxCell id="wf-h1" value="A. Startup And Setup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#295b66;strokeColor=#295b66;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1w">
          <mxGeometry x="40" y="20" width="520" height="42" as="geometry" />
        </mxCell>
        <mxCell id="wf-h2" value="B. One Extraction Round" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#295b66;strokeColor=#295b66;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1w">
          <mxGeometry x="620" y="20" width="760" height="42" as="geometry" />
        </mxCell>
        <mxCell id="wf-h3" value="C. Append Loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#295b66;strokeColor=#295b66;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1w">
          <mxGeometry x="1470" y="20" width="470" height="42" as="geometry" />
        </mxCell>
        <mxCell id="wf-h4" value="D. Finalization And Export" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#295b66;strokeColor=#295b66;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1w">
          <mxGeometry x="2020" y="20" width="620" height="42" as="geometry" />
        </mxCell>

        <mxCell id="wf-l1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfaf5;strokeColor=#ddd5c7;" vertex="1" parent="1w">
          <mxGeometry x="40" y="75" width="520" height="1790" as="geometry" />
        </mxCell>
        <mxCell id="wf-l2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfaf5;strokeColor=#ddd5c7;" vertex="1" parent="1w">
          <mxGeometry x="620" y="75" width="760" height="1790" as="geometry" />
        </mxCell>
        <mxCell id="wf-l3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfaf5;strokeColor=#ddd5c7;" vertex="1" parent="1w">
          <mxGeometry x="1470" y="75" width="470" height="1790" as="geometry" />
        </mxCell>
        <mxCell id="wf-l4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfaf5;strokeColor=#ddd5c7;" vertex="1" parent="1w">
          <mxGeometry x="2020" y="75" width="620" height="1790" as="geometry" />
        </mxCell>

        <mxCell id="wf1" value="1. App starts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6dfef;strokeColor=#9a86a8;fontStyle=1;" vertex="1" parent="1w">
          <mxGeometry x="90" y="110" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="wf2" value="2. Load ontology&#xa;into memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeee2;strokeColor=#7ca483;" vertex="1" parent="1w">
          <mxGeometry x="90" y="250" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="wf3" value="3. User may upload&#xa;a new ontology" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0cf;strokeColor=#cfb26a;" vertex="1" parent="1w">
          <mxGeometry x="90" y="400" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="wf4" value="4. New ontology&#xa;replaces the active one" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeee2;strokeColor=#7ca483;" vertex="1" parent="1w">
          <mxGeometry x="90" y="540" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="wf5" value="5. User may also upload&#xa;an existing graph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0cf;strokeColor=#cfb26a;" vertex="1" parent="1w">
          <mxGeometry x="90" y="690" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="wf6" value="6. New base graph resets&#xa;sessions and cached search data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde0d7;strokeColor=#c1775f;" vertex="1" parent="1w">
          <mxGeometry x="90" y="830" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="wf7" value="7. Open the extract page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0cf;strokeColor=#cfb26a;fontStyle=1;" vertex="1" parent="1w">
          <mxGeometry x="90" y="990" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wf-note-setup" value="Setup state&#xa;Ontology is in memory, a starting graph may exist, and no extraction session is active yet." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fdf0cf;strokeColor=#d18c57;" vertex="1" parent="1w">
          <mxGeometry x="90" y="1130" width="320" height="140" as="geometry" />
        </mxCell>

        <mxCell id="wf8" value="8. Submit text&#xa;for extraction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0cf;strokeColor=#cfb26a;fontStyle=1;" vertex="1" parent="1w">
          <mxGeometry x="690" y="110" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="wf9" value="9. Request reaches backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeee2;strokeColor=#7ca483;" vertex="1" parent="1w">
          <mxGeometry x="1020" y="110" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="wf10" value="10. Create or reuse session.&#xa;Base rows seed `base_kb_json`&#xa;and `current_kb_json`, or both start empty." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeee2;strokeColor=#7ca483;" vertex="1" parent="1w">
          <mxGeometry x="690" y="260" width="620" height="100" as="geometry" />
        </mxCell>
        <mxCell id="wf11" value="11. `current_kb_json` becomes&#xa;the working context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f4ef;strokeColor=#827b72;" vertex="1" parent="1w">
          <mxGeometry x="690" y="410" width="620" height="70" as="geometry" />
        </mxCell>
        <mxCell id="wf12" value="12. Build AI request from&#xa;text, ontology rules, and graph context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcecf7;strokeColor=#7a9fb0;fontStyle=1;" vertex="1" parent="1w">
          <mxGeometry x="690" y="530" width="620" height="140" as="geometry" />
        </mxCell>
        <mxCell id="wf13" value="13. Retrieve graph context through&#xa;label hits, FTS, and embeddings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcecf7;strokeColor=#7a9fb0;" vertex="1" parent="1w">
          <mxGeometry x="690" y="720" width="620" height="110" as="geometry" />
        </mxCell>
        <mxCell id="wf14" value="14. Send prompt and context&#xa;to the AI model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcecf7;strokeColor=#7a9fb0;fontStyle=1;" vertex="1" parent="1w">
          <mxGeometry x="690" y="880" width="620" height="120" as="geometry" />
        </mxCell>
        <mxCell id="wf15" value="15. AI returns proposed rows&#xa;and raw changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcecf7;strokeColor=#7a9fb0;" vertex="1" parent="1w">
          <mxGeometry x="690" y="1050" width="620" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wf16" value="16. Validate rows against the ontology, remove duplicates,&#xa;and build the preview" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeee2;strokeColor=#7ca483;" vertex="1" parent="1w">
          <mxGeometry x="690" y="1180" width="620" height="130" as="geometry" />
        </mxCell>
        <mxCell id="wf17" value="17. Browser receives the proposal,&#xa;reasoning, and preview data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0cf;strokeColor=#cfb26a;" vertex="1" parent="1w">
          <mxGeometry x="690" y="1360" width="620" height="120" as="geometry" />
        </mxCell>
        <mxCell id="wf18" value="18. Prepare old and proposed&#xa;graphs for display" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0cf;strokeColor=#cfb26a;fontStyle=1;" vertex="1" parent="1w">
          <mxGeometry x="690" y="1530" width="620" height="100" as="geometry" />
        </mxCell>
        <mxCell id="wf18b" value="19. Preview graph highlights&#xa;old vs new" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde0d7;strokeColor=#c1775f;fontStyle=1;" vertex="1" parent="1w">
          <mxGeometry x="690" y="1645" width="620" height="110" as="geometry" />
        </mxCell>

        <mxCell id="wf19" value="20. Reviewer inspects&#xa;the proposal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0cf;strokeColor=#cfb26a;fontStyle=1;" vertex="1" parent="1w">
          <mxGeometry x="1565" y="110" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="wf20" value="21. Reviewer may edit rows&#xa;before accepting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0cf;strokeColor=#cfb26a;" vertex="1" parent="1w">
          <mxGeometry x="1565" y="230" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wf21" value="22. Append accepted rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeee2;strokeColor=#7ca483;fontStyle=1;" vertex="1" parent="1w">
          <mxGeometry x="1565" y="360" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="wf22" value="23. Deduplicate accepted rows into&#xa;`current_kb_json` and increment `kb_revision`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeee2;strokeColor=#7ca483;" vertex="1" parent="1w">
          <mxGeometry x="1565" y="520" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="wf23" value="24. Updated graph becomes&#xa;the next-round context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde0d7;strokeColor=#c1775f;fontStyle=1;" vertex="1" parent="1w">
          <mxGeometry x="1565" y="690" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="wf24" value="25. Ready for the next&#xa;text batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0cf;strokeColor=#cfb26a;" vertex="1" parent="1w">
          <mxGeometry x="1565" y="860" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="wf25" value="26. More text to process?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fdf0cf;strokeColor=#cfb26a;fontStyle=1;" vertex="1" parent="1w">
          <mxGeometry x="1545" y="1010" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="wf26" value="Yes: run another round&#xa;with the updated graph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeee2;strokeColor=#7ca483;" vertex="1" parent="1w">
          <mxGeometry x="1565" y="1210" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="wf27" value="No: move to Finalize" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0cf;strokeColor=#cfb26a;fontStyle=1;" vertex="1" parent="1w">
          <mxGeometry x="1565" y="1360" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="wf-note-loop" value="Loop summary&#xa;Generate, review, append, and repeat.&#xa;Each accepted batch expands the working graph." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fdf0cf;strokeColor=#d18c57;" vertex="1" parent="1w">
          <mxGeometry x="1535" y="1490" width="340" height="130" as="geometry" />
        </mxCell>

        <mxCell id="wf28" value="27. Finalize auto-appends&#xa;any pending proposal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde0d7;strokeColor=#c1775f;fontStyle=1;" vertex="1" parent="1w">
          <mxGeometry x="2140" y="110" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="wf29" value="28. Open final page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0cf;strokeColor=#cfb26a;" vertex="1" parent="1w">
          <mxGeometry x="2140" y="270" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wf30" value="29. Load session state,&#xa;default query, and export data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeee2;strokeColor=#7ca483;" vertex="1" parent="1w">
          <mxGeometry x="2140" y="400" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="wf31" value="30. Compute&#xa;`rows_delta(base_kb_json, current_kb_json)`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeee2;strokeColor=#7ca483;" vertex="1" parent="1w">
          <mxGeometry x="2140" y="560" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="wf32" value="31. Important&#xa;Export only the session delta.&#xa;If no base graph exists, the delta is the created graph." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde0d7;strokeColor=#c1775f;fontStyle=1;" vertex="1" parent="1w">
          <mxGeometry x="2140" y="720" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="wf33" value="32. Build final graph and export package&#xa;from queryRows + finalRows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde0d7;strokeColor=#c1775f;fontStyle=1;" vertex="1" parent="1w">
          <mxGeometry x="2140" y="890" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="wf34" value="33. Are unresolved placeholders present?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fdf0cf;strokeColor=#cfb26a;fontStyle=1;" vertex="1" parent="1w">
          <mxGeometry x="2180" y="1040" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="wf35" value="No&#xa;Single-step export is ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeee2;strokeColor=#7ca483;" vertex="1" parent="1w">
          <mxGeometry x="2100" y="1230" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="wf36" value="Yes&#xa;Two-step export is needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeee2;strokeColor=#7ca483;" vertex="1" parent="1w">
          <mxGeometry x="2350" y="1230" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="wf37" value="34. Step 1&#xa;Create new items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0cf;strokeColor=#cfb26a;" vertex="1" parent="1w">
          <mxGeometry x="2350" y="1380" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wf38" value="35. Paste the created IDs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0cf;strokeColor=#cfb26a;" vertex="1" parent="1w">
          <mxGeometry x="2350" y="1500" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wf39" value="36. Step 2&#xa;Generate final export" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeee2;strokeColor=#7ca483;" vertex="1" parent="1w">
          <mxGeometry x="2350" y="1620" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="wf40" value="37. Final result&#xa;Review final graph, copy export,&#xa;and import into Wikibase" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee6cf;strokeColor=#d18c57;fontStyle=1;" vertex="1" parent="1w">
          <mxGeometry x="2160" y="1740" width="350" height="110" as="geometry" />
        </mxCell>

