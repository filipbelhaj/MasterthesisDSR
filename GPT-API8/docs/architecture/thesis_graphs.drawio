  <diagram id="kg-creation-loop" name="KG Creation Loop">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0d" />
        <mxCell id="1d" parent="0d" />

        <mxCell id="kg_h1" value="Iterative KG Construction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#295b66;strokeColor=#295b66;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1d">
          <mxGeometry x="50" y="30" width="1160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kg_h2" value="Final Export" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#295b66;strokeColor=#295b66;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1d">
          <mxGeometry x="1260" y="30" width="560" height="40" as="geometry" />
        </mxCell>

        <mxCell id="kg_mode" value="Start Session&#xa;create_new or&#xa;extend_existing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1d">
          <mxGeometry x="100" y="230" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="kg_cur" value="current_kb_json&#xa;working graph" style="shape=database;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1d">
          <mxGeometry x="390" y="240" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="kg_text" value="Submit New&#xa;Source Text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1d">
          <mxGeometry x="680" y="230" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="kg_gen" value="Generate Proposal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1d">
          <mxGeometry x="940" y="240" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="kg_rev" value="Human Review&#xa;inspect reasoning&#xa;and edit rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1d">
          <mxGeometry x="390" y="520" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="kg_app" value="Approve And Append" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1d">
          <mxGeometry x="700" y="540" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="kg_dedupe" value="Deduplicate Rows&#xa;increment kb_revision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1d">
          <mxGeometry x="970" y="530" width="190" height="100" as="geometry" />
        </mxCell>

        <mxCell id="kg_fin" value="Finalize Session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1d">
          <mxGeometry x="1320" y="170" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="kg_delta" value="rows_delta&#xa;(base, current)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1d">
          <mxGeometry x="1320" y="320" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="kg_s1" value="Step 1 QuickStatements&#xa;create new entities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1d">
          <mxGeometry x="1600" y="120" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="kg_map" value="Bind Placeholder QIDs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1d">
          <mxGeometry x="1600" y="280" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="kg_s2" value="Step 2 QuickStatements&#xa;final statements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1d">
          <mxGeometry x="1600" y="430" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="kg_wb" value="Wikibase Cloud" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1d">
          <mxGeometry x="1620" y="600" width="170" height="90" as="geometry" />
        </mxCell>

        <mxCell id="kg_note" value="Key thesis point: only approved rows become future retrieval context.&#xa;Extraction and deployment are separated for control and traceability." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;" vertex="1" parent="1d">
          <mxGeometry x="70" y="760" width="600" height="110" as="geometry" />
        </mxCell>

        <mxCell id="kg_e1" value="" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1d" source="kg_mode" target="kg_cur">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kg_e2" value="" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1d" source="kg_cur" target="kg_text">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kg_e3" value="" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1d" source="kg_text" target="kg_gen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kg_e4" value="proposal + reasoning" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1d" source="kg_gen" target="kg_rev">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kg_e5" value="" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1d" source="kg_rev" target="kg_app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kg_e6" value="" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1d" source="kg_app" target="kg_dedupe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kg_e7" value="next round uses updated graph" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1d" source="kg_dedupe" target="kg_cur">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1065" y="420" />
              <mxPoint x="485" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="kg_e8" value="export path" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1d" source="kg_cur" target="kg_fin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kg_e9" value="" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1d" source="kg_fin" target="kg_delta">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kg_e10" value="" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1d" source="kg_delta" target="kg_s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kg_e11" value="" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1d" source="kg_s1" target="kg_map">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kg_e12" value="" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1d" source="kg_map" target="kg_s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kg_e13" value="import" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1d" source="kg_s2" target="kg_wb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
