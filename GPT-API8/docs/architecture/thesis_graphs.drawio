        </mxCell>
        <mxCell id="df_cur2" value="current_kb_json&#xa;updated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1c">
          <mxGeometry x="1740" y="930" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="df_delta" value="delta_kb_json&#xa;rows_delta(base,current)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1c">
